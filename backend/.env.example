# ---------------------------------------------------------------
# NC Carrom 2026 - backend configuration
# Copy this file to .env and fill in your database details.
# ---------------------------------------------------------------

# --- Neon Postgres (primary) -----------------------------------
# Neon console -> your project -> Connection string -> "psql".
# It looks like this (keep sslmode=require):
# DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-cool-name-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# The tables are created automatically on first start. If you would
# rather run the DDL yourself, use db/schema.sql.

# --- Supabase (only if you ever switch off Neon) ---------------
# Used only when DATABASE_URL above is empty.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# With all of the above blank, the API falls back to a local JSON file
# (backend/data/tournament.json) so you can demo without any database.

# --- sign-in ---------------------------------------------------------
# One organiser login. There is no sign-up screen: these two values ARE
# the account. Change the password before the event.
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-before-the-event

# A second, read-only account for players and spectators. They see every
# screen - tables, fixtures, the Super Six, the bracket - and can change
# nothing. Leave blank to switch the viewer account off entirely.
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=nccarrom

# Signs the session tokens. Any long random string will do, e.g. from
#   python -c "import secrets; print(secrets.token_hex(32))"
# Leave it blank and a new one is made each time the API starts, which
# signs you out on every restart.
SESSION_SECRET=

# How long a sign-in lasts before it has to be repeated.
SESSION_HOURS=12

# Leaving AUTH_USERNAME or AUTH_PASSWORD blank switches sign-in OFF and
# the API is open to anyone who can reach it. It warns loudly on startup.

# Identifies this tournament inside the tables, so the same database
# can host 2027 later on.
TOURNAMENT_SLUG=nc-carrom-2026

# Comma separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
